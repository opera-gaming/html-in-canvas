{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "bash tools/build-site.sh",
  "outputDirectory": "public",
  "trailingSlash": true,
  "redirects": [{ "source": "/", "destination": "/html-in-canvas/", "permanent": false }],
  "rewrites": [{ "source": "/html-in-canvas/:path*", "destination": "/:path*" }]
}
