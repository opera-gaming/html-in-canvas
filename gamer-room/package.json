{
  "name": "html-in-canvas-room",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:blender": "/Applications/Blender.app/Contents/MacOS/Blender -b blender/Scene_isometric.blend --python tools/export.py -- public/models/room.glb",
    "bake:blender": "/Applications/Blender.app/Contents/MacOS/Blender -b blender/Scene_isometric.blend --python-exit-code 1 --python tools/bake.py -- public/lightmaps",
    "bake:quick": "/Applications/Blender.app/Contents/MacOS/Blender -b blender/Scene_isometric.blend --python-exit-code 1 --python tools/bake.py -- public/lightmaps-quick --quick"
  },
  "dependencies": {
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.64.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
